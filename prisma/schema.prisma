// Viora — Prisma schema (Sprint 0)
//
// This is the conceptual data model from docs/sprint-0-brief.md §4, extended with the
// placeholders required by docs/00-START-HERE.md §2 and the entity overview in
// docs/project-plan-v1.md §5. See docs/decisions.md for the reasoning behind the less
// obvious choices (multi-role users, per-OrderItem hub status, the AiSettings/PlatformSetting
// placeholders, etc).
//
// Sprint 0 only builds the schema + basic CRUD needed for the page skeletons. Business logic
// (real party-wizard suggestions, payment/settlement processing, the print-partner workflow)
// is out of scope and lands in later sprints — see docs/sprint-0-brief.md §7.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  SELLER
  SERVICE_PROVIDER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  /// A user can hold more than one role at once (e.g. a customer who is also a seller).
  /// A JSON array of Role values, not a native list column - see docs/decisions.md ADR 20
  /// (supersedes ADR 7's Postgres-array reasoning; MySQL has no native scalar-list column type).
  roles     Json      @default("[\"CUSTOMER\"]")
  /// Optional; collected once on the account profile for future birthday marketing SMS.
  /// See party-wizard-engine-spec.md §5 — not used for anything yet in Sprint 0.
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sellerProfile          SellerProfile?
  serviceProviderProfile ServiceProviderProfile?
  partyProfiles          PartyProfile[]
  orders                 Order[]
  reviews                Review[]
  supportTickets         SupportTicket[]
}

/// Mock phone/OTP auth (docs/decisions.md ADR 2). A real SMS provider is swapped in later
/// behind SmsProvider (lib/providers/sms) without touching this table.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// ---------------------------------------------------------------------------
// Phasing (city / category) — project-plan-v1.md §3: every phase toggle is a DB flag,
// never a code branch.
// ---------------------------------------------------------------------------

model City {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings         Listing[]
  serviceOfferings ServiceOffering[]
  partyProfiles    PartyProfile[]
  sellerProfiles   SellerProfile[]
}

enum CategoryType {
  PARTY_TYPE
  PRODUCT
  SERVICE
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products         Product[]
  serviceOfferings ServiceOffering[]
  sellerCategories SellerCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([type, isActive])
}

// ---------------------------------------------------------------------------
// Marketplace vendors
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// SellerProfile's own status set, distinct from ApprovalStatus (still used as-is by
/// ServiceProviderProfile) - SUSPENDED is a seller-only concept (docs/decisions.md ADR 38), set
/// only by manual admin action, never automatically. A dedicated enum rather than adding
/// SUSPENDED to the shared ApprovalStatus so a print partner's status column can never even
/// represent a value that has no meaning for it.
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Product seller (fixed monthly subscription) — panels-and-operations-spec.md §2.
model SellerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  businessName String
  /// نام و نام‌خانوادگی مسئول فروشگاه - distinct from businessName (the shop's trade name).
  /// Nullable only because it's a new column on a table with existing rows (ADR 29's migration
  /// note convention) - sellers who registered before this field existed simply have it empty.
  /// See docs/decisions.md ADR 39.
  contactPersonName String?
  /// Free-text shop description, shown on the seller's own registration/profile - not a
  /// per-product field. See docs/decisions.md ADR 27.
  description  String? @db.Text
  /// Either an uploaded logo (via StorageProvider) or one of the built-in default avatars
  /// (public/avatars/*.svg, see lib/avatars.ts) - a single URL either way. Nullable only because
  /// it's a new column on a table with existing rows (see ADR 29's migration note); the
  /// registration wizard always has one selected (a default is pre-picked) before submit.
  avatarUrl    String?
  /// A shop can sell across more than one product category at once - a join table, not a single
  /// FK (superseding ADR 27's single categoryId). See docs/decisions.md ADR 29.
  categories   SellerCategory[]
  nationalId   String
  /// شناسه‌ی صنفی - a separate business/trade-union registration number, distinct from the
  /// individual's national ID above. See docs/decisions.md ADR 29.
  unionId      String?
  /// Photo of the seller's پروانه‌ی کسب (business license), uploaded via StorageProvider.
  businessLicenseImageUrl String?
  bankAccountIban         String
  cityId                  String?
  city                    City?   @relation(fields: [cityId], references: [id])
  /// Shop/warehouse address - collected as free text, not tied to City (which only exists for
  /// phase-gating - see ADR 29's note on why city selection was dropped from the wizard itself).
  address                 String? @db.Text
  /// A JSON array of phone number strings (MySQL has no native scalar-list column - ADR 20). At
  /// least one is required at the API layer - a schema-level minimum can't be expressed for Json.
  phoneNumbers            Json    @default("[]")
  /// How the seller heard about Viora - one of a fixed set of options, or "other" with free text
  /// in referralSourceOther. See docs/decisions.md ADR 29.
  referralSource          String?
  referralSourceOther     String?
  /// Set once, at registration, when the seller checks the terms-agreement checkbox. A nullable
  /// "set = happened" timestamp, matching OtpCode.consumedAt/OrderItem.shippedAt's convention
  /// elsewhere in this schema, not a boolean.
  termsAcceptedAt         DateTime?
  status                  SellerStatus @default(PENDING)
  rejectionReason         String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings          Listing[]
  /// Catalog Products this seller originally submitted for admin review (docs/decisions.md
  /// ADR 39) - kept even after approval as a simple "who proposed this" record. Distinct from
  /// `listings`, which is every product this seller currently sells (including ones someone
  /// else's submission created the catalog entry for).
  submittedProducts Product[]
  subscriptions     Subscription[]
  orderItems        OrderItem[]

  @@index([status])
}

/// Join table for SellerProfile <-> Category (a shop can sell across several categories at
/// once) - see docs/decisions.md ADR 29. No extra fields on the relationship itself, so this is
/// a plain composite-PK join table, not a full entity.
model SellerCategory {
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])

  @@id([sellerProfileId, categoryId])
  @@index([categoryId])
}

/// Service provider (per-order commission) — e.g. the balloon-print partner today, more
/// service categories later (DJ, photographer, ...) per project-plan-v1.md §3 phase 1.
model ServiceProviderProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  businessName    String
  /// نام و نام‌خانوادگی مسئول کسب‌وکار - distinct from businessName. Nullable for the same reason
  /// as SellerProfile.contactPersonName: existing partners registered before this field existed.
  /// See docs/decisions.md ADR 39.
  contactPersonName String?
  /// Photo of the partner's پروانه‌ی کسب/مدارک هویتی, uploaded via StorageProvider - same
  /// convention as SellerProfile.businessLicenseImageUrl (ADR 29).
  businessLicenseImageUrl String?
  nationalId      String
  bankAccountIban String
  /// Percentage, e.g. 12.50 for 12.5%. Defaults to a placeholder platform-wide rate - real
  /// per-partner commission negotiation is out of scope for this phase, same simplification as
  /// subscription/commission management was for the seller panel (ADR 27). See docs/decisions.md
  /// ADR 31.
  commissionRate  Decimal        @default(10.00) @db.Decimal(5, 2)
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?        @db.Text
  /// "تاییدیه‌ی ویژه‌ی ویورا" badge (docs/decisions.md ADR 42) - manually toggled by an admin only,
  /// no real payment behind it yet since this project's whole payment layer is still a mock
  /// (PaymentProvider.charge()). Shown in the customer-facing partner list and given a positive
  /// ranking weight in getMatchingPrintProviders.
  isVerifiedByViora Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOfferings ServiceOffering[]
  settlements      Settlement[]
  orderItems       OrderItem[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Catalog — Product (the shared catalog entry: what a product IS) is split from Listing (one
// seller's price/stock/discount offer against it), so more than one seller can carry the same
// catalog product. See docs/decisions.md ADR 39.
// ---------------------------------------------------------------------------

/// PENDING_REVIEW: a seller submitted a brand-new catalog entry, awaiting admin decision.
/// APPROVED: live in the catalog, has a `code`. REJECTED: admin declined it outright, with
/// `rejectionReason` - final, the submitting seller cannot resubmit. NEEDS_REVISION: admin wants
/// changes with `rejectionReason` explaining what; the seller edits and resubmits, which returns
/// this row to PENDING_REVIEW. A dedicated enum (not the shared ApprovalStatus) since NEEDS_
/// REVISION has no equivalent there - same "don't widen a shared enum for a concept it can't
/// represent" reasoning as SellerStatus above.
enum ProductStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

/// Atomic sequential counter behind Product.code's "VP" + number scheme - a dedicated singleton
/// row rather than reusing PlatformSetting, since PlatformSetting.value is Json and Prisma's
/// atomic `increment` only works on a real numeric scalar column. Incremented via upsert +
/// increment inside a $transaction (docs/decisions.md ADR 39): MySQL/InnoDB row-locks this single
/// row for the transaction's duration, so concurrent admin approvals still assign distinct,
/// gapless-in-practice codes instead of racing.
model ProductCodeCounter {
  id    String @id @default("singleton")
  value Int    @default(0)
}

/// The shared catalog entry - title/description/category/photos - independent of who sells it or
/// for how much (docs/decisions.md ADR 39). A Product only ever has one approved shape; every
/// seller carrying it has their own Listing for price/stock/discount/city.
model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  slug        String   @unique
  /// @db.Text: MySQL's default VARCHAR(191) truncates real product descriptions - see ADR 20.
  description String?  @db.Text
  /// A JSON array of image URLs, not a native list column - see docs/decisions.md ADR 20.
  images      Json     @default("[]")
  /// Viora's own product code, "VP" + a sequential number (e.g. VP10042) - assigned only once
  /// approved, via ProductCodeCounter, and never reused or renumbered afterward. Null while still
  /// PENDING_REVIEW/NEEDS_REVISION/REJECTED.
  code   String?       @unique
  status ProductStatus @default(PENDING_REVIEW)
  /// Set together with status = REJECTED or NEEDS_REVISION - same "reason accompanies a
  /// rejection" convention as SellerProfile.rejectionReason.
  rejectionReason String? @db.Text
  /// The seller who originally submitted this catalog entry for review - kept even after
  /// approval as a simple "who proposed this" record. Null for products that entered the catalog
  /// some other way (e.g. the seeded catalog, migrated in directly as APPROVED).
  submittedBySellerId String?
  submittedBySeller   SellerProfile? @relation(fields: [submittedBySellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings   Listing[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId, status])
  @@index([status])
  @@index([submittedBySellerId])
}

/// One seller's price/stock/discount offer against a shared Product (docs/decisions.md ADR 39).
/// A Product can have several Listings, at most one per seller (`@@unique([productId, sellerId])`).
/// OrderItem/Review still point directly at productId + a separate sellerId, unchanged - that pair
/// already uniquely identifies which Listing was used, so no listingId FK was added there.
model Listing {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  cityId    String
  /// Independent of the seller's own registered city - a seller can list the same product for a
  /// different city, same per-listing choice this field already allowed on Product before the
  /// split.
  city City @relation(fields: [cityId], references: [id])
  /// Toman, whole numbers only.
  price Decimal @db.Decimal(12, 0)
  /// The seller's own optional lower price (docs/decisions.md ADR 35) - entirely absorbed by the
  /// seller, unlike a platform Coupon, so it's simply used in place of `price` everywhere a real
  /// charge/split is computed (checkout, OrderItem.unitPrice/splitAmount) - never a separate
  /// calculation. null = no discount; when set, must be strictly less than `price` (enforced at
  /// the API layer, not the DB, matching this schema's existing convention of not encoding
  /// cross-field invariants in SQL).
  discountPrice Decimal? @db.Decimal(12, 0)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sellerId])
  @@index([cityId, isActive])
  @@index([sellerId])
}

/// Custom-workflow service, e.g. promotional balloon printing — panels-and-operations-spec.md §3.
model ServiceOffering {
  id          String                  @id @default(cuid())
  providerId  String
  provider    ServiceProviderProfile  @relation(fields: [providerId], references: [id])
  categoryId  String
  category    Category                @relation(fields: [categoryId], references: [id])
  cityId      String
  city        City                    @relation(fields: [cityId], references: [id])
  title       String
  slug        String                  @unique
  description String?                 @db.Text
  /// A "starting from" display price (the lowest pricingTiers.unitPrice at save time) for
  /// generic listing cards, e.g. the party wizard's auxiliary-service suggestion
  /// (lib/wizard/engine.ts) - the real per-order price for a print job comes from matching the
  /// requested quantity against pricingTiers, not this field. See docs/decisions.md ADR 31.
  basePrice   Decimal                 @db.Decimal(12, 0)
  /// Per-service custom order fields (e.g. balloon print: design upload, run size, colors).
  /// Shape is defined by the service category, not fixed here — see
  /// panels-and-operations-spec.md §3. Superseded for balloon printing specifically by the
  /// structured fields below (ADR 31) - kept as-is for any future service category that isn't
  /// balloon printing. Unused by any UI.
  customFieldsSchema Json?
  /// Balloon finish types this partner can print - a fixed 2-value set (not a join table like
  /// SellerCategory's open-ended list - ADR 29) since there are only ever two, per
  /// panels-and-operations-spec.md §3. See docs/decisions.md ADR 31.
  supportsChrome Boolean @default(false)
  supportsMatte  Boolean @default(false)
  /// A JSON array of color-name strings this partner can print, chosen at registration from the
  /// admin-curated PrintColor list (docs/decisions.md ADR 32) - stored as a plain string
  /// snapshot, not a relation, since MySQL has no native scalar-list column (ADR 20) and a
  /// partner's already-saved selection must survive an admin later removing that color.
  printableColors Json    @default("[]")
  /// Orders below this quantity never show this partner as a match - null means "not a print
  /// offering" (a future non-print ServiceOffering has no such concept).
  minOrderQuantity Int?
  isActive    Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  reviews      Review[]
  pricingTiers PrintPricingTier[]

  @@index([cityId, categoryId, isActive])
  @@index([providerId])
}

/// One quantity-based pricing band a print partner defines for themselves at registration
/// (e.g. 100-500 units -> 5,700 Toman/unit) - panels-and-operations-spec.md §3's "تعرفه‌ی
/// پلکانی". A dedicated table, not JSON on ServiceOffering, since real price computation needs
/// to query/compare these ranges, not just display them - see docs/decisions.md ADR 31.
model PrintPricingTier {
  id                String          @id @default(cuid())
  serviceOfferingId String
  serviceOffering   ServiceOffering @relation(fields: [serviceOfferingId], references: [id])
  minQuantity       Int
  /// null = this is the open-ended top tier ("این تعداد و بیشتر").
  maxQuantity Int?
  /// Toman, per unit.
  unitPrice   Decimal @db.Decimal(12, 0)

  createdAt DateTime @default(now())

  @@index([serviceOfferingId])
}

/// The admin-curated set of printable balloon colors (docs/decisions.md ADR 32) - partners pick
/// from this list at registration (ServiceOffering.printableColors stores the chosen names as a
/// plain string snapshot, not a relation to this table, so removing a color here never touches
/// a partner's already-saved offering), and customers pick from the same list when ordering.
model PrintColor {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Party Wizard data flywheel — project-plan-v1.md §6, party-wizard-engine-spec.md §5.
// Sprint 0 only ever writes ageGroup/guestCount/budget/cityId/theme from the plain
// multi-step form; the AI-related fields exist so the schema doesn't change shape
// when that sprint lands (docs/decisions.md ADR 4).
// ---------------------------------------------------------------------------

model PartyProfile {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  partyType  String
  ageGroup   String
  guestCount Int
  budget     Decimal @db.Decimal(12, 0)
  cityId     String
  city       City    @relation(fields: [cityId], references: [id])
  theme      String

  /// Raw free-text input, once the AI-assisted entry point exists (party-wizard-engine-spec.md §1).
  rawInputText         String?  @db.Text
  extractedFields      Json?
  wasManuallyCorrected Boolean?
  suggestedBundle      Json?
  finalBundle          Json?

  createdAt DateTime @default(now())

  orders Order[]

  @@index([userId])
  @@index([cityId, theme])
}

// ---------------------------------------------------------------------------
// Orders — panels-and-operations-spec.md §1
// ---------------------------------------------------------------------------

enum OrderType {
  SINGLE_SELLER
  MULTI_SELLER
  /// A print-partner order (panels-and-operations-spec.md §3) - a single ServiceProviderProfile
  /// transaction, not a product-seller one, so SINGLE_SELLER's name would be misleading. See
  /// docs/decisions.md ADR 31.
  SERVICE
}

/// The two balloon finish types this platform prints, per panels-and-operations-spec.md §3 -
/// used both as what a partner supports (ServiceOffering.supportsChrome/supportsMatte) and what
/// a specific order requests (OrderItem.printFinish).
enum BalloonFinish {
  CHROME
  MATTE
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Hub processing pipeline for a multi-seller (party-wizard) order — tracked per OrderItem
/// because each seller ships to the Viora hub independently. See docs/decisions.md ADR 6.
enum HubProcessingStatus {
  PENDING_SELLER_SHIPMENT
  RECEIVED_AT_HUB
  QUALITY_CHECK
  FINAL_SHIPPED
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  partyProfileId String?
  partyProfile   PartyProfile? @relation(fields: [partyProfileId], references: [id])
  orderType      OrderType
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING)
  /// Toman, whole numbers only. Already net of couponDiscountAmount below - what's actually
  /// charged via PaymentProvider.charge(). See docs/decisions.md ADR 35.
  totalAmount     Decimal      @db.Decimal(12, 0)
  shippingAddress String?       @db.Text
  /// Used for the hub's minimum-lead-time rule on multi-seller orders (configurable via
  /// PlatformSetting, not hardcoded — panels-and-operations-spec.md §1).
  eventDate DateTime?

  /// A platform-wide Coupon applied at checkout (docs/decisions.md ADR 35) - independent of any
  /// seller's own Product.discountPrice. Never null'd retroactively if the coupon is later
  /// deactivated; Coupon rows are never hard-deleted (only toggled inactive - same convention as
  /// City/Category, ADR 30) specifically so this relation always resolves.
  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  /// Snapshot of the exact amount deducted by the coupon at order time (never recomputed later
  /// from live Coupon data, same "snapshot, don't re-read" convention as OrderItem.unitPrice/
  /// expressFee). Zero when no coupon was applied - not nullable, since "no discount" and "not
  /// yet computed" are the same thing here, unlike deliveredAt's genuine nullable "set = happened".
  discountAmount Decimal @default(0) @db.Decimal(12, 0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([couponId])
}

/// One vendor's line item within an order. `sellerId`/`providerId` is only ever one of the two,
/// matching whichever of `productId`/`serviceOfferingId` is set.
model OrderItem {
  id                String                  @id @default(cuid())
  orderId           String
  order             Order                   @relation(fields: [orderId], references: [id])
  productId         String?
  product           Product?                @relation(fields: [productId], references: [id])
  serviceOfferingId String?
  serviceOffering   ServiceOffering?        @relation(fields: [serviceOfferingId], references: [id])
  sellerId          String?
  seller            SellerProfile?          @relation(fields: [sellerId], references: [id])
  providerId        String?
  provider          ServiceProviderProfile? @relation(fields: [providerId], references: [id])
  quantity          Int                     @default(1)
  unitPrice         Decimal                 @db.Decimal(12, 0)
  /// This vendor's payout share once split-payment is wired up (project-plan-v1.md §5).
  splitAmount Decimal @db.Decimal(12, 0)
  /// Only set when the parent Order.orderType is MULTI_SELLER.
  hubStatus HubProcessingStatus?
  /// The seller/provider's own fulfillment step for a SINGLE_SELLER order - a nullable
  /// timestamp, not a status enum, matching OtpCode.consumedAt's "set = happened" convention
  /// elsewhere in this schema. null = still preparing; set = shipped. Independent of hubStatus,
  /// which is the (currently unused - see ADR 22) multi-seller hub pipeline. See ADR 27. Reused
  /// as-is for a SERVICE order's final delivery step - see ADR 31.
  shippedAt    DateTime?
  /// Set together with shippedAt, by whoever ships this line item.
  trackingCode String?
  /// Set when the *customer* confirms receipt (the "سفارش رو دریافت کردم" button on their order
  /// detail page, not something automatic or set by the seller/provider - docs/decisions.md
  /// ADR 33). Same nullable "set = happened" convention as shippedAt. Two things depend on this
  /// being a real, separately-set timestamp rather than inferred from shippedAt: the review
  /// prompt (only once an item is actually confirmed received, not merely shipped) and, per
  /// docs/legal-pages-draft.md §3, the 24-hour return window for physical products, which is
  /// defined from the moment of delivery.
  deliveredAt DateTime?

  // ---- SERVICE (print-partner) order fields - only set when this OrderItem's serviceOffering
  // is a print offering. See docs/decisions.md ADR 31. ----
  /// The customer's uploaded artwork, via StorageProvider.
  designFileUrl String?
  /// One color from the chosen provider's own printableColors list at order time.
  printColor    String?
  printFinish   BalloonFinish?
  /// false (default) = normal turnaround (an informational date-range shown from
  /// PlatformSetting, not stored per-order); true = the customer picked an exact date and paid
  /// expressFee.
  isExpressDelivery     Boolean   @default(false)
  requestedDeliveryDate DateTime?
  /// Snapshot of PlatformSetting's print_express_fee at order time (like unitPrice/splitAmount,
  /// never re-read live later) - only set when isExpressDelivery is true.
  expressFee    Decimal?  @db.Decimal(12, 0)
  customerNotes String?   @db.Text
  /// Set when the provider accepts this order - gates whether they can see designFileUrl/
  /// printColor/customerNotes at all (panels-and-operations-spec.md §3's two-stage visibility).
  /// Nullable "set = happened" timestamp, same convention as shippedAt above.
  acceptedAt DateTime?
  /// Set when the currently-assigned provider requests this already-accepted print order be
  /// picked up by a different partner instead (docs/decisions.md ADR 42's "بازار واگذاری
  /// سفارش") - null means not up for reassignment. Only meaningful between acceptedAt and
  /// shippedAt; whichever other eligible provider claims it first gets providerId/
  /// serviceOfferingId reassigned to them and this cleared back to null - the original provider
  /// keeps full access (can still ship it themselves) for as long as nobody else has claimed it.
  reassignmentRequestedAt DateTime?

  createdAt DateTime @default(now())

  review Review?

  /// Set once a customer requests a return via the "درخواست مرجوعی" button on a delivered item
  /// (docs/decisions.md ADR 38, the 24-hour return window deliveredAt's own comment above
  /// references) - null means no return was ever requested. A completely separate lifecycle from
  /// hubStatus (which tracks *getting the item to the customer*, not what happens after).
  returnStatus ReturnStatus?
  /// Set together with returnStatus = REJECTED - same "reason accompanies a rejection" convention
  /// as SellerProfile.rejectionReason/ServiceProviderProfile.rejectionReason.
  returnRejectionReason String? @db.Text
  returnTickets         SupportTicket[]

  @@index([orderId])
  @@index([sellerId])
  @@index([providerId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Platform-wide discount codes — docs/decisions.md ADR 35. Independent of, and stackable with,
// a seller's own Product.discountPrice (which needs no dedicated model - it's just an optional
// second price on Product).
// ---------------------------------------------------------------------------

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType
  /// A percentage (e.g. 20 for 20%) when type is PERCENTAGE, or a flat Toman amount when type
  /// is FIXED_AMOUNT.
  value Decimal @db.Decimal(12, 0)
  /// Caps the computed discount - only meaningful for PERCENTAGE (a FIXED_AMOUNT coupon's own
  /// value already is its cap). null = uncapped.
  maxDiscountAmount Decimal? @db.Decimal(12, 0)
  /// Minimum order subtotal (after any seller-level discount, before this coupon) required to
  /// use this code. null = no minimum.
  minOrderAmount Decimal? @db.Decimal(12, 0)
  /// Total successful (PAID) redemptions allowed across all customers. null = unlimited.
  maxRedemptions Int?
  /// Successful (PAID) redemptions allowed per individual customer. null = unlimited.
  maxRedemptionsPerUser Int?
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Product seller's fixed monthly plan — panels-and-operations-spec.md §2.
model Subscription {
  id               String             @id @default(cuid())
  sellerId         String
  seller           SellerProfile      @relation(fields: [sellerId], references: [id])
  plan             String
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

enum SettlementStatus {
  PENDING
  PAID
}

/// Commission payout to a service provider — project-plan-v1.md §5. No PaymentProvider
/// wiring in Sprint 0; this is a schema placeholder for the settlement sprint.
model Settlement {
  id          String           @id @default(cuid())
  providerId  String
  provider    ServiceProviderProfile @relation(fields: [providerId], references: [id])
  amount      Decimal          @db.Decimal(12, 0)
  status      SettlementStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Reviews — panels-and-operations-spec.md §5, party-wizard-engine-spec.md §8.
// Schema placeholder only; no review UI ships in Sprint 0.
// ---------------------------------------------------------------------------

model Review {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  serviceOfferingId String?
  serviceOffering   ServiceOffering? @relation(fields: [serviceOfferingId], references: [id])
  orderItemId       String?          @unique
  orderItem         OrderItem?       @relation(fields: [orderItemId], references: [id])
  rating            Int
  comment           String?          @db.Text
  /// Moderation gate - a new review is never shown on a public product page until an admin
  /// approves it (docs/decisions.md ADR 40). Reviews that already existed before this field was
  /// added were backfilled `true` (they were already publicly visible) - only genuinely new
  /// reviews start out pending.
  isApproved        Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([serviceOfferingId])
  @@index([isApproved])
}

// ---------------------------------------------------------------------------
// Support — 00-START-HERE.md §2: in-platform tickets for customers. Schema placeholder
// only; no ticket UI ships in Sprint 0 (sprint-0-brief.md §1 excludes the full admin panel).
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Distinguishes a plain support conversation from a structured return request
/// (docs/decisions.md ADR 38) - drives the admin filter/badge and which extra actions (approve/
/// reject return) apply to a ticket. GENERAL is the default so every ticket from the plain
/// "تماس با پشتیبانی" entry point keeps working exactly as before.
enum TicketType {
  GENERAL
  RETURN_REQUEST
}

model SupportTicket {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  subject String
  status  TicketStatus @default(OPEN)
  type    TicketType   @default(GENERAL)
  /// Set only for RETURN_REQUEST tickets - the OrderItem this return is about. Nullable since a
  /// GENERAL ticket has no associated order item.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
  @@index([orderItemId])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])
  /// The id of whoever wrote it — the ticket's own owner, or an admin user.
  authorId String
  /// Set only by the admin-side reply route (docs/decisions.md ADR 34) - which endpoint handled
  /// the request decides this, not whether the author's account also happens to hold ADMIN
  /// elsewhere. A ticket owner who is also an admin, replying to their own ticket from their own
  /// /support page, still gets false here - only a reply sent through /admin/tickets sets true.
  /// This is what the UI uses to tell a customer/seller/partner message apart from a staff one;
  /// comparing authorId to the ticket's own userId alone can't do this (they're the same account
  /// in that self-admin case).
  isFromStaff Boolean @default(false)
  body        String  @db.Text
  /// A photo attached to this message, via the same StorageProvider every other upload in this
  /// app uses (docs/decisions.md ADR 38) - used today only by the return-request flow's initial
  /// message ("عکس از کالا"). A general field on the message itself rather than a return-specific
  /// column elsewhere, since a message is already the right shape for "what was said, plus
  /// optional evidence."
  imageUrl String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Admin-editable configuration — never hardcoded (00-START-HERE.md §0.5).
// ---------------------------------------------------------------------------

/// Single-row config for the future AIExtractorProvider (party-wizard-engine-spec.md §6).
/// Nothing reads this in Sprint 0 — see docs/decisions.md ADR 4. When apiUrl/apiKey are
/// empty, the wizard must keep working via the plain multi-step form, never fail.
model AiSettings {
  id        String   @id @default("singleton")
  apiUrl    String?
  apiKey    String?
  modelName String?
  updatedAt DateTime @updatedAt
}

/// Generic admin-editable key/value store for everything that doesn't need its own table:
/// the hub's minimum-lead-time buffer, the print-partner support contact block, etc.
/// (panels-and-operations-spec.md §1, §4). Banner slots and seasonal theme - also named here
/// originally - got their own dedicated models instead (SeasonalTheme, Banner below): both
/// need several independent, individually-dated rows (several themes/banners scheduled across
/// the year) plus admin list/CRUD pages, which a singleton-style key/value row doesn't fit.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Seasonal theme + banners — panels-and-operations-spec.md §4's "تم فصلی/مناسبتی" and
// "مدیریت بنر/اعلامیه". Both follow the same "date-window decides live activation" shape as
// Coupon (ADR 35): isActive is an admin kill switch, startsAt/endsAt decide whether an
// otherwise-active row is actually live *today* - checked live on every request (this project
// has no cron/background-job runner to do it out-of-band), never a value flipped by a daily job.
// See docs/decisions.md ADR 36.
// ---------------------------------------------------------------------------

/// One named color palette (e.g. "یلدا") that replaces the default Champagne Rose palette
/// (app/globals.css's `@theme` block) site-wide while it's live. `palette` is a flat JSON map
/// keyed by every token name `lib/theme.ts`'s CHAMPAGNE_ROSE_PALETTE defines (e.g. "rose-500",
/// "warm-white") to a replacement hex string - a full replacement set, not a sparse override, so
/// there's never a question of what a partially-specified theme falls back to. Unlike Coupon's
/// genuinely-optional startsAt/endsAt, both are required here: a theme with no date window isn't
/// "seasonal" at all, and the live-activation query (lib/data/theme.ts's getActiveSeasonalTheme)
/// needs a well-defined window to pick at most one active theme when rows could otherwise overlap.
model SeasonalTheme {
  id       String   @id @default(cuid())
  name     String
  palette  Json
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

/// Fixed set of UI banner slots - deliberately an enum, not a free-text field, so the admin picks
/// from a real dropdown instead of typing a placement name that has to match what a template
/// happens to render (panels-and-operations-spec.md §4). Only one value for now; more slots are
/// additive (new enum members), never a schema change to this model.
enum BannerPlacement {
  HOME_TOP
}

model Banner {
  id        String          @id @default(cuid())
  imageUrl  String
  text      String
  /// Optional - a purely informational banner needs no destination.
  link      String?
  placement BannerPlacement @default(HOME_TOP)
  isActive  Boolean         @default(true)
  /// Unlike SeasonalTheme, a banner can reasonably run with no end date (a standing announcement)
  /// or take effect immediately (no start date) - same optional-window convention as Coupon.
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, startsAt, endsAt])
}
