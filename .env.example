# Copy this file to .env and fill in real values for your machine/environment.
# See docs/README.md for what each provider variable controls.

# MySQL/MariaDB - see docs/decisions.md ADR 20. The deploy host's own cPanel-provided MySQL
# needs no international connectivity at all (unlike the Postgres/Neon setup ADR 20 replaced),
# so there's no separate driver mode to pick here - just point this at a real MySQL/MariaDB.
DATABASE_URL="mysql://root:@localhost:3306/viora_dev"

# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=""

# "console" (mock, logs to server console) is the only implementation in Sprint 0.
SMS_PROVIDER="console"

# "local" (writes to /public/uploads) for local dev only - see docs/decisions.md ADR 27 for why
# this is unsafe on the actual deploy host (the `deploy` branch is force-pushed fresh on every
# build, and uploaded files under public/uploads aren't part of that history). "s3" is required
# for the seller panel's product-image uploads in production - works with any S3-compatible
# object storage (Liara Object Storage, ArvanCloud Object Storage, or real AWS S3).
STORAGE_PROVIDER="local"

# Only read when STORAGE_PROVIDER="s3". Example endpoints (check your provider's current docs -
# these change occasionally):
#   Liara Object Storage:    S3_ENDPOINT="https://storage.iran.liara.space"
#   ArvanCloud Object Storage: S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
# S3_PUBLIC_URL_BASE is usually the same host as S3_ENDPOINT plus your bucket name
# (e.g. "https://storage.iran.liara.space/my-bucket") unless your provider gives you a separate
# CDN domain - check the provider's panel for the exact public URL of an object you upload.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="default"
S3_PUBLIC_URL_BASE=""

# "mock" (always succeeds, no real charge) is the only implementation in Sprint 0.
PAYMENT_PROVIDER="mock"
