# Copy this file to .env and fill in real values for your machine/environment.
# See docs/README.md for what each provider variable controls.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viora_dev?schema=public"

# How PrismaClient connects to DATABASE_URL at runtime - see docs/decisions.md (ADR 16, 18).
# "pg" (default): direct TCP, port 5432. Use for local dev against a normal local Postgres.
# "neon": Neon's serverless driver over a WebSocket Upgrade, port 443.
# "neon-http": Neon's serverless driver over plain HTTPS POST, no WebSocket at all. No Prisma
#   transaction support in this mode - see ADR 18.
# The current deploy host blocks 5432 AND WebSocket Upgrades, so it needs "neon-http"
# specifically - set that (and DATABASE_URL to a Neon connection string) on that host's own
# environment variables, not here (this file is for local dev).
DATABASE_DRIVER="pg"

# Random secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=""

# "console" (mock, logs to server console) is the only implementation in Sprint 0.
SMS_PROVIDER="console"

# "local" (writes to /public/uploads) is the only implementation in Sprint 0.
STORAGE_PROVIDER="local"

# "mock" (always succeeds, no real charge) is the only implementation in Sprint 0.
PAYMENT_PROVIDER="mock"
